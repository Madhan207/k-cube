# =============================================
# K-CUBE Audit & FinServ - Loan System
# Environment Variables Example
# =============================================
# Copy this file to .env and fill in values.
# NEVER commit .env to Git.

# ----- Django -----
SECRET_KEY=your-very-long-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_SETTINGS_MODULE=config.settings.dev

# ----- Database -----
DATABASE_URL=postgres://kcube_user:kcube_secure_pass@localhost:5432/kcube_loans
POSTGRES_DB=kcube_loans
POSTGRES_USER=kcube_user
POSTGRES_PASSWORD=kcube_secure_pass

# ----- JWT -----
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ----- File Storage -----
# Local storage (development)
USE_S3=False
MEDIA_ROOT=media
MEDIA_URL=/media/

# AWS S3 Compatible (production)
AWS_ACCESS_KEY_ID=your-s3-access-key
AWS_SECRET_ACCESS_KEY=your-s3-secret-key
AWS_STORAGE_BUCKET_NAME=kcube-loan-documents
AWS_S3_ENDPOINT_URL=https://s3.amazonaws.com
AWS_S3_REGION_NAME=ap-south-1
AWS_DEFAULT_ACL=private

# ----- KYC / PAN Verification Provider -----
# Replace with your authorized provider credentials
PAN_API_KEY=your-pan-verification-api-key
PAN_API_URL=https://api.your-pan-provider.com/v1/pan/verify
PAN_API_PROVIDER=provider_name

# Aadhaar / e-KYC Provider
AADHAAR_API_KEY=your-aadhaar-api-key
AADHAAR_API_URL=https://api.your-aadhaar-provider.com/v1
AADHAAR_API_PROVIDER=provider_name

# ----- Email -----
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=hrkcube@gmail.com
EMAIL_HOST_PASSWORD=your-email-app-password
DEFAULT_FROM_EMAIL=K-CUBE Audit & FinServ <hrkcube@gmail.com>

# ----- Redis (for caching / rate limiting) -----
REDIS_URL=redis://localhost:6379/0

# ----- Security (Production) -----
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# ----- App Config -----
COMPANY_NAME=K-CUBE Audit & FinServ
COMPANY_ADDRESS=#7, KVS Complex, Salem Main Road, Kalipatti
COMPANY_PHONE=+91 98656 82992
COMPANY_EMAIL=hrkcube@gmail.com
LOAN_ID_PREFIX=KCF-LOAN
AGREEMENT_ID_PREFIX=KCF-AGR
BORROWER_ID_PREFIX=KCF-BOR
